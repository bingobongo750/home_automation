# Copy to .env and fill in real values. .env is gitignored.

# Serial port for the Arduino Due, programming port (find yours with: ls /dev/tty.usb*)
SERIAL_PORT=/dev/tty.usbmodem14101
SERIAL_BAUD=115200

# SQLite database path. Use an ABSOLUTE path — run.py is started from server/
# (systemd sets WorkingDirectory there), so a relative ./data/home.db quietly
# resolves to server/data/home.db and the hub writes to a second, empty
# database instead of the real one. Leaving this unset is also safe: the code
# defaults to <repo>/data/home.db, resolved from the source tree, not the CWD.
# DB_PATH=/home/<user>/home_automation/data/home.db

# myStrom WiFi Switch local IPs (give them static DHCP reservations on the
# router). Plug 2 is seeded as a placeholder until it's physically installed.
MYSTROM_PLUG_IP=192.168.0.51
MYSTROM_PLUG2_IP=192.168.0.52

# Poll interval in seconds for the myStrom plug (state + power draw)
MYSTROM_POLL_INTERVAL=10

# Shelly bulb zone local IPs (Multicolor Bulb E27 Gen3, static DHCP
# reservations recommended). Both are seeded as placeholders until each bulb
# is physically screwed in and provisioned onto WiFi.
SHELLY_CUPBOARD_IP=192.168.0.61
SHELLY_ROOM_LED_IP=192.168.0.62

# Auto-lighting job: how often (seconds) it re-checks lux and pushes
# brightness to any zone in 'auto' mode; the lux level below which a room
# counts as "dark"; the brightness (0-255) a dark zone is set to (a "bright"
# reading turns the zone off).
LIGHTING_POLL_INTERVAL=30
LIGHTING_LUX_THRESHOLD=50
LIGHTING_AUTO_BRIGHTNESS=180

# Flask bind address/port
HOST=0.0.0.0
PORT=8000

# Set to 1 to run without any physical hardware: fakes Arduino sensor data
# and myStrom plug responses so the dashboard is developable on its own.
MOCK_HARDWARE=0
