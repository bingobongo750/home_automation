# Copy to .env and fill in real values. .env is gitignored.

# Serial port for the Arduino Due, programming port (find yours with: ls /dev/tty.usb*)
SERIAL_PORT=/dev/tty.usbmodem14101
SERIAL_BAUD=115200

# SQLite database path. Use an ABSOLUTE path — run.py is started from server/
# (systemd sets WorkingDirectory there), so a relative ./data/home.db quietly
# resolves to server/data/home.db and the hub writes to a second, empty
# database instead of the real one. Leaving this unset is also safe: the code
# defaults to <repo>/data/home.db, resolved from the source tree, not the CWD.
# DB_PATH=/home/<user>/home_automation/data/home.db

# myStrom WiFi Switch local IPs (give them static DHCP reservations on the
# router). Plug 2 is seeded as a placeholder until it's physically installed.
MYSTROM_PLUG_IP=192.168.0.51
MYSTROM_PLUG2_IP=192.168.0.52

# Poll interval in seconds for the myStrom plug (state + power draw)
MYSTROM_POLL_INTERVAL=10

# Shelly bulb zone local IPs (Multicolor Bulb E27 Gen3, static DHCP
# reservations recommended). Both are seeded as placeholders until each bulb
# is physically screwed in and provisioned onto WiFi.
SHELLY_CUPBOARD_IP=192.168.0.61
SHELLY_ROOM_LED_IP=192.168.0.62

# Auto-lighting job: how often (seconds) it re-checks lux and drives any zone
# in 'auto' mode whose master switch is on.
LIGHTING_POLL_INTERVAL=30
# Auto lighting holds the MEASURED room level at this many lux (closed loop —
# see server/app/lighting_control.py). Seeds the user-owned setting; 0 disables.
LIGHTING_TARGET_LUX=5
# Control tuning. Hunting around the target => lower the gain; minutes to settle
# => raise it. The rest rarely needs touching.
LIGHTING_DEADBAND_LUX=1.0
LIGHTING_GAIN=6.0
LIGHTING_MAX_STEP=16
LIGHTING_SETTLE_S=8
LIGHTING_STALE_AFTER_S=120
# The controller's brightness ceiling (0-255). Full scale: below that the loop
# reports "at maximum" while the bulb still has headroom.
LIGHTING_AUTO_BRIGHTNESS=255

# Presence (docs/presence-design.md). Two iPhone Shortcuts POST departure and
# arrival; the host decides the scene. A departure is only applied after the
# grace period, so a bouncing geofence cannot strobe the room. The away
# summary's window ends ARRIVAL_TRIM seconds before the detected arrival —
# you reach the door before the hub knows, and that stretch is you, not an
# intruder. Repeated detections inside DISTURBANCE_COOLDOWN count as one event.
PRESENCE_DEPART_GRACE_S=120
PRESENCE_ARRIVAL_TRIM_S=120
PRESENCE_SUMMARY_MIN_S=600
DISTURBANCE_COOLDOWN_S=300

# Flask bind address/port
HOST=0.0.0.0
PORT=8000

# Set to 1 to run without any physical hardware: fakes Arduino sensor data
# and myStrom plug responses so the dashboard is developable on its own.
MOCK_HARDWARE=0
